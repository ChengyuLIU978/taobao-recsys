{
  "architecture": "native PyTorch encoder-decoder Transformer",
  "d_model": 128,
  "nhead": 4,
  "encoder_layers": 2,
  "decoder_layers": 2,
  "dim_feedforward": 256,
  "dropout": 0.1,
  "positional_encoding": "learned",
  "batch_size": 64,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "epochs": 10,
  "early_stopping_patience": 2,
  "checkpoint_metric": "validation_recall_at_20",
  "checkpoint_tie_break": "validation_ndcg_at_20",
  "beam_size": 50,
  "evaluation_user_batch_size": 64,
  "length_normalization": false,
  "seed": 42,
  "history_source": "train_only",
  "history_cutoff_protocol": "train.csv only for validation and test, matching scripts/07_build_multistage_recall.py",
  "event_pooling": "six token embeddings are pooled per event before the Transformer encoder; all six tokens remain represented",
  "selection_rule": "validation Recall@20; NDCG@20 tie-break",
  "best_epoch": 10,
  "test_read_during_training_or_selection": false
}